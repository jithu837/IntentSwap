# IntentSwap Backend Environment Variables
# Copy to .env and fill in your values

# ── Server ──────────────────────────────────────────────────────────
PORT=4000

# ── MongoDB ─────────────────────────────────────────────────────────
# Local:   mongodb://localhost:27017/intentswap
# Atlas:   mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/intentswap
MONGO_URI=mongodb://localhost:27017/intentswap

# ── Ethereum ─────────────────────────────────────────────────────────
# Local Hardhat node:  http://127.0.0.1:8545
# Sepolia Alchemy:     https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
RPC_URL=http://127.0.0.1:8545

# Address of the deployed IntentEscrow contract
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Private key of the backend-operated solver wallet (hex, no 0x prefix)
# This wallet MUST have tokenOut pre-approved to the contract
SOLVER_PRIVATE_KEY=

# ── CORS ─────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
